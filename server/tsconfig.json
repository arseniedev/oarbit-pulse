{
    "compilerOptions": {
      /* Language & runtime */
      "target": "ES2020",
      "lib": ["ES2020"],
  
      /* Module system (IMPORTANT for Express projects) */
      "module": "CommonJS",
      "moduleResolution": "node",
  
      /* Output structure */
      "rootDir": "./src",
      "outDir": "./dist",
  
      /* Type safety */
      "strict": true,
      "noImplicitAny": true,
      "strictNullChecks": true,
  
      /* Interop (fixes cors/express import issues) */
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
  
      /* Developer experience */
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
  
      /* Build behavior */
      "sourceMap": true
    },
  
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
  }